// Phoenix Fox build settings.
// Copy this file to Config.xcconfig. Do not commit the copy.
// META_CLIENT_TOKEN is a CI secret. Leave it empty for a local unsigned compile.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.cinderandcrown.phoenixfox

// Owner / DAT Developer Mode (default for owner TestFlight): MetaAppID 0 skips
// attestation. Meta AI Developer Mode must be ON. No Wearables Developer Center
// release-channel invite required. After installing, Disconnect & re-register once.
META_APP_ID = 0
META_CLIENT_TOKEN = 0
PHOENIX_FOX_OWNER_BUILD = YES

// Standard / release-channel path (Developer Mode OFF in Meta AI): use the real
// Wearables Developer Center App ID + ClientToken, invite the tester to Beta, and
// have them select that Release Channel. Uncomment and fill these instead of 0:
// META_APP_ID = 1651172483404286
// META_CLIENT_TOKEN = your_client_token_from_wearables_developer_center
// PHOENIX_FOX_OWNER_BUILD = NO
