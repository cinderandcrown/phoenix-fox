# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
# Keep the embedded SwiftPM lockfile (engineering standard: Package.resolved committed).
!*.xcodeproj/project.xcworkspace/
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
!*.xcworkspace/xcshareddata/swiftpm/
!*.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
DerivedData/
# Snapshot pictures that did not match their reference. CI uploads them; they are never committed.
OpenVisionTests/__Snapshots__/failed/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Config files with secrets (use .example versions)
Config.xcconfig
OpenVision/Config/Config.swift
*.p8
relay/.dev.vars
relay/.wrangler/
relay/node_modules/

# CocoaPods — ignore standalone workspaces at repo root only (not project.xcworkspace).
Pods/
Podfile.lock
/*.xcworkspace

# Swift Package Manager
.build/
.swiftpm/
# Ignore any stray root Package.resolved from CLI experiments.
/Package.resolved

# Carthage
Carthage/Build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# IDE
*.swp
*.swo
*~
.idea/
.vscode/

# Build outputs
build/
*.app

# Archives
*.xcarchive

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Testing
*.coverage
*.profraw
*.profdata

# Crashlytics
crashlytics-build.properties
fabric.properties

# Claude Code
.claude/

# Python
__pycache__/

# Meta DAT vendor checkout and official agent skills (Meta Wearables Developer Terms —
# not redistributable). Regenerated by scripts/setup_mac.sh on macOS / CI.
.vendor/
.agents/skills/meta-official-*/

*.p12
*.mobileprovision
.env
.env.*
!*.example
