<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Information -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Phoenix Fox</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- The app uses only the encryption that iOS provides (HTTPS, and CryptoKit for data it
         stores on the phone), which is exempt from export paperwork. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Supported Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Launch Screen -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>

    <!-- Queried URL Schemes (Meta AI app) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fb-viewapp</string>
        <string>whatsapp</string>
        <string>fb-messenger</string>
    </array>

    <!-- Required Device Capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>microphone</string>
    </array>

    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
        <string>external-accessory</string>
        <string>location</string>
        <string>remote-notification</string>
    </array>

    <!-- External Accessory protocol for Meta Wearables -->
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.meta.ar.wearable</string>
    </array>

    <!-- Privacy - Usage Descriptions -->

    <!-- Microphone for voice input -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Phoenix Fox uses the glasses microphone so you can talk to your assistant hands-free.</string>

    <!-- Camera for photo capture -->
    <key>NSCameraUsageDescription</key>
    <string>Phoenix Fox uses the glasses camera so your assistant can see what you see when you ask it to.</string>

    <key>NSContactsUsageDescription</key>
    <string>Phoenix Fox looks up a phone number or email when you ask Jarvis to call, text, or email someone. You still tap send.</string>
    <key>NSAppleMusicUsageDescription</key>
    <string>Phoenix Fox pauses, plays, or skips the phone's music player when you ask Jarvis.</string>

    <!-- Speech recognition for wake word detection -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Phoenix Fox uses speech recognition to hear the wake word Jarvis and to transcribe what you say.</string>

    <!-- Bluetooth for glasses connection -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Phoenix Fox connects to your AI glasses over Bluetooth for the camera and microphone.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Phoenix Fox connects to your AI glasses over Bluetooth.</string>

    <!-- Photo Library for saving captured images -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Phoenix Fox can save a photo from the glasses to your library.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Phoenix Fox can use a photo from your library when you ask Jarvis about it.</string>

    <!-- Location (if needed for context) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Phoenix Fox can use your location when you turn that on, so Jarvis can answer with where you are.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Phoenix Fox uses location to speak a reminder when you arrive at a place you named. The system location arrow stays visible while that reminder is armed.</string>
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Productivity tools -->
    <key>NSCalendarsUsageDescription</key>
    <string>Phoenix Fox reads and adds calendar events when you ask Jarvis.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Phoenix Fox reads and adds calendar events when you ask Jarvis.</string>
    <key>NSRemindersUsageDescription</key>
    <string>Phoenix Fox creates reminders when you ask Jarvis.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Phoenix Fox creates reminders when you ask Jarvis.</string>

    <!-- App Transport Security (allow WebSocket connections) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Wearables Device Access Toolkit configuration. The Meta AI app returns to this
         universal link. It is written out here, not read from a build setting, because
         an xcconfig file treats the two slashes in a URL as the start of a comment. -->
    <key>MWDAT</key>
    <dict>
        <key>AppLinkURLScheme</key>
        <string>https://phoenix-fox-links.cinderandcrown.workers.dev/dat</string>
        <key>MetaAppID</key>
        <string>1651172483404286</string>
        <key>ClientToken</key>
        <string>$(META_CLIENT_TOKEN)</string>
        <key>TeamID</key>
        <string>$(DEVELOPMENT_TEAM)</string>
    </dict>

    <!-- Appearance -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- Status Bar -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
</dict>
</plist>
