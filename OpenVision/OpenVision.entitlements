<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Raise the jetsam memory ceiling so the on-device Gemma 4 VLM (~3.6 GB) plus the
         vision encoder can run without being killed under memory pressure. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    <key>aps-environment</key>
    <string>development</string>
    <!-- Wi-Fi for the glasses camera: the phone joins the network the glasses host, and
         the toolkit reads which network the phone is on. Both are in Meta's sample app,
         and without them in the signature streaming over Wi-Fi fails without an error. -->
    <key>com.apple.developer.networking.HotspotConfiguration</key>
    <true/>
    <key>com.apple.developer.networking.wifi-info</key>
    <true/>
    <!-- Universal links. The Meta AI app returns here after glasses registration. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:phoenix-fox-links.cinderandcrown.workers.dev</string>
    </array>
</dict>
</plist>
